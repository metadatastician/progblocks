# PLAYBOOK.a2ml — Operational playbook for progblocks

[metadata]
version = "0.1.0"
last-updated = "2026-08-07"

[testing]
command = "just test"
underlying = "node --test tests/"
notes = "Justfile's test recipe used to be `node --test tests/ || echo \"No tests configured yet\"` — the `|| echo` fallback swallowed a real test failure and exited 0 regardless of what node --test reported. That fallback has been removed; the recipe is now `node --test` and a green `just test` run means the tests actually passed. Verify against the live Justfile if you have reason to doubt this."
direct-command = "node --test tests/"

[demo]
method = "static-file"
steps = [
  "python3 -m http.server 8080   # or any static file server, from the repo root",
  "open http://localhost:8080/index.html",
]
notes = "index.html loads two <prog-block> elements directly via a relative <script type=module> import of src/prog-block.js — no build step. The demo previously had a named-import mismatch in src/prog-block.js (see descriptiles/AGENTIC.a2ml and STATE.a2ml) that threw a SyntaxError at module-load time, so customElements.define never ran and both elements on the page stayed inert. That import has been fixed (tests/registration.test.js now guards it), so the demo registers and renders. Re-verify against the live src/prog-block.js if you have reason to doubt this."
launcher-caveat = "progblocks-launcher.sh (generated, do not hand-edit) cannot currently start this demo server either — REPO_DIR is never populated and the startup-command search can never match a non-executable string like \"python3 -m http.server\". Use the manual python3 -m http.server command above instead; see AGENTIC.a2ml and STATE.a2ml for the launch-scaffolder bug."

[ci-verification]
workflows = [
  { file = ".github/workflows/ci.yml", steps = "checkout -> setup-node@20 -> npm ci -> install just -> just test", notes = "npm ci now has a package.json/lockfile to install from. The Justfile no longer has a build recipe (it cat-concatenated ES modules without stripping import/export syntax and never produced a runnable bundle; it has been deleted rather than fixed) and ci.yml does not invoke `just check` or `just build`." },
  { file = ".github/workflows/codeql.yml", steps = "matrix scan: actions, javascript-typescript" },
  { file = ".github/workflows/secret-scanner.yml", steps = "gitleaks" },
]
lockfile = ".github/workflows/actions.lock — generated by `gh actions-lock`; uses: lines correctly carry tag refs, and the lockfile holds the resolved SHAs. Do not re-inline SHAs into the workflow files; that breaks the lockfile model and has caused startup_failure elsewhere in the estate."

[diagnostic-notes]
notes = [
  "`gh pr checks` HIDES startup_failure runs — it reports only checks that actually produced a check run. Use `gh run list --repo metadatastician/progblocks` to see the true state, including any startup_failure entries gh pr checks silently omits.",
  "CI never had a green run from repo creation (2026-07-23) until the rehabilitation sequence beginning with PR #12 — see FACTS.md's Rehabilitation history table for exact PR numbers and root causes (Actions allowlist gap, JS CodeQL coverage gap, workflow-lockfile enforcement, CodeQL default-vs-advanced conflict).",
]

[incident-response]
steps = [
  "Check .machine_readable/descriptiles/STATE.a2ml for current status.",
  "Run `gh run list --repo metadatastician/progblocks` — not `gh pr checks`, which hides startup_failure.",
  "If the component itself is at issue, first check whether src/prog-block.js's import of k9-validator.js still names `validateK9` (a mismatch); this is the single highest-impact known defect and blocks everything downstream of component registration.",
]

[release-process]
steps = [
  "Nothing has been released yet — treat this repo as pre-alpha (FACTS.md).",
  "Resolve the version drift (package.k9/contracts.ncl say 1.0.0; progblocks.launcher.a2ml/progblocks-launcher.sh say 0.1.0; package.json says 0.3.0) before any tag is cut.",
]
