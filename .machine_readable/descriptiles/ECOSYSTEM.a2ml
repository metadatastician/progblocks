# SPDX-License-Identifier: MPL-2.0
# ECOSYSTEM.a2ml — progblocks' ecosystem position

[metadata]
project = "progblocks"
ecosystem = "metadatastician"

[position]
type = "web component / library"
purpose = "Dependency-free web component for variant-aware, personalisable code examples in technical documentation and wikis: variant switching (generic WAI-ARIA tabs, no OS/shell/language semantics, optional page-local group sync), {{ variable }} substitution (regex, not a real A2ML parse), copy-to-clipboard of the personalised text, and clipboard-safe line numbers."
# IS-NOT — anti-identity (the boundary-erosion guard)
what-this-is-not = [
  "a syntax highlighter",
  "a static site generator",
  "a Markdown parser",
  "a full A2ML implementation — the parser (a2ml-parser.js) is a stub; variable substitution is plain regex, not a real parse; the tree-sitter WASM asset is a 118-byte ASCII placeholder",
  "a code editor, IDE, or language-server client — the contenteditable editor, the placeholder linter panel, and the unused view-manager.js WebSocket code were removed on 2026-10-05 as out of charter",
  "a data-conversion tool — smart paste and JSON/CSV/Nickel/TXT export were removed on 2026-10-05",
  "a released package — nothing has been published to any registry; version numbers disagree across files (1.0.0 in package.k9/contracts.ncl, 0.1.0 in the launcher config, 0.3.0 in package.json)",
]

[pipeline]
position = "leaf, embeddable"
chain = "conceived for metadatastician/berrywiki, decoupled by design -> embeddable in any consumer"
notes = "Conceived for BerryWiki but built standalone from the start so it can be injected into ddraig-ssg output, nextgen-languages previewers, or plain Markdown sites. It does not itself generate a site or parse Markdown — it is a widget a site embeds."
coordination = "none observed in this tree — no consumer repo currently imports src/prog-block.js; this is a stated design intent in README.md, not a verified live integration"

[related-projects]
projects = [
  { name = "berrywiki", relationship = "originating consumer (intended)", notes = "progblocks was conceived for BerryWiki. No import of src/prog-block.js from berrywiki has been verified in this pass." },
  { name = "ddraig-ssg", relationship = "candidate consumer", notes = "A static-site generator this component is designed to be injectable into. progblocks is not ddraig-ssg and does not generate sites itself." },
  { name = "nextgen-languages", relationship = "candidate consumer", notes = "Previewer surfaces named as a target integration in README.md; not verified as wired up in this tree." },
]
