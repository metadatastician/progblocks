#
# AGENTIC.a2ml — AI agent constraints and capabilities
# Defines what AI agents can and cannot do in this repository.

[metadata]
version = "0.1.0"
last-updated = "2026-08-07"

[agent-permissions]
can-edit-source = true
can-edit-tests = true
can-edit-docs = true
can-edit-config = true
can-create-files = true

[agent-constraints]
# What AI agents must NOT do:
# - Never commit secrets or credentials.
# - Never hand-edit progblocks-launcher.sh. It is GENERATED by
#   launch-scaffolder from progblocks.launcher.a2ml (marked "do not edit" in
#   the file itself). The generator currently loses its {repo-dir} tokens,
#   producing a script that cannot start the server: a blank line before
#   the shebang, an empty REPO_DIR, an absolute /assets/icon-256.png that
#   does not exist, and a startup-command search requiring [ -x "$candidate" ]
#   that is false for a string like "python3 -m http.server", so
#   START_COMMAND is always empty. This is an upstream launch-scaffolder
#   bug affecting every generated launcher in the estate — file it
#   upstream and regenerate here; do not patch the .sh output by hand.
# - Never re-inline action SHAs that .github/workflows/actions.lock owns.
#   The lockfile is the pin (gh actions-lock); `uses:` lines correctly
#   carry tag refs. "Fixing" them back to inline SHAs breaks the lockfile
#   model and has caused startup_failure elsewhere in the estate.
# - Never claim in documentation that a feature the code does not
#   implement exists. In particular, as of 2026-08-07: there is no
#   code/preview toggle, no templating wizard (no storage, no forms, no
#   wizard code anywhere in the tree), no working live linter (the
#   rendered panel is the hardcoded string '<i>Linter ready</i>'), and
#   split-view is wired to a :host([split-view="…"]) CSS selector the JS
#   never reflects onto the host attribute. Read FACTS.md's "Feature
#   reality" section before writing anything that reads as a capability
#   claim.
# - Never describe A2ML variable substitution as "backed by the A2ML
#   parser" — it is plain regex (/\{\{\s*([\w:-]+)\s*\}\}/g); a2ml-parser.js
#   is a stub whose tree-sitter path is commented out and whose parse
#   function is never called.
# - Licence is MPL-2.0 for this repo — do not swap in AGPL or another
#   licence.

[maintenance-integrity]
fail-closed = true
require-evidence-per-step = true
allow-silent-skip = false
require-rerun-after-fix = true
release-claim-requires-hard-pass = true

# The component must actually register before any claim of "it works" is
# made: customElements.get('prog-block') must be defined. As of 2026-08-07
# this is TRUE in the tree at HEAD — src/prog-block.js was fixed to import
# { defaultValidator } from k9-validator.js instead of the non-existent
# { validateK9 }. That named-import mismatch was a link-time SyntaxError:
# the module graph never finished loading, and
# customElements.define('prog-block', ...) never ran. A real registration
# test (tests/registration.test.js, asserting
# customElements.get('prog-block') exists) is now in the tree and passes
# (`npm test`, 5/5). Re-verify against the live source before trusting this
# if the tree has moved since 2026-08-07.
component-registration-invariant = "customElements.get('prog-block') must be truthy after loading src/prog-block.js — currently true, guarded by tests/registration.test.js; see descriptiles/STATE.a2ml"

[automation-hooks]
# on-enter: read /0-AI-MANIFEST.a2ml, then descriptiles/STATE.a2ml
# on-exit: update STATE.a2ml with session outcomes
# on-commit: ci.yml's `build` job (checkout -> setup-node -> just test) is the real gate
