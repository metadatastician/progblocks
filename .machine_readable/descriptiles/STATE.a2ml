# SPDX-License-Identifier: MPL-2.0
# STATE.a2ml — ProgBlocks
#
# Current project state, phase, and route to the next milestone.
# Machine-readable snapshot; keep in sync with README.md and FACTS.md.

[metadata]
project = "ProgBlocks"
version = "0.1.0"   # per progblocks.launcher.a2ml; see [notes] on version drift below
last-updated = "2026-10-05"
status = "active"

[project-context]
name = "progblocks"
purpose = "Dependency-free web component for variant-aware, personalisable code examples in technical documentation and wikis: WAI-ARIA variant tabs with optional cross-block group sync, {{ variable }} substitution with inline defaults, copy-to-clipboard of the personalised text, and clipboard-safe line numbers."
language = "javascript (ESM, no build)"
runtime = "any modern browser"
dependencies = "none at runtime; dev dependencies happy-dom and @happy-dom/global-registrator (see package.json)"
distribution = "no build artefact; consumers import src/prog-block.js directly"
completion-percentage = 35   # NOT re-scored on 2026-10-05 — the rationale below
                              # is historical. It scored the 8 features the old
                              # README advertised, of which roughly 3 worked.
                              # On 2026-10-05 (branch feat/render-core-variants-vars)
                              # the README feature table was rewritten to the
                              # charter: variant tabs, group sync, variables,
                              # copy, line numbers and safe rendering work and are
                              # unit-tested under happy-dom; accessibility is
                              # implemented but not verified; smart paste, structured export,
                              # the linter, split view and the inline editor were
                              # removed as out of charter. The owner should
                              # re-score this figure against the new table.

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts
                            # NOT beta: nothing has been exercised in a real
                            # browser, a screen reader, or an automated
                            # accessibility audit; all behavioural tests run
                            # under happy-dom; nothing has been released. The
                            # advertised-but-absent features that used to keep
                            # this below beta were removed from scope on
                            # 2026-10-05 rather than built.

[route-to-mvp]
milestones = [
  { name = "Repo scaffolded, MPL-2.0 licensing, estate hygiene pass (PR #15)", completion = 100 },
  { name = "CI unblocked — just installer allowlisted, JS CodeQL coverage, workflow lockfile (PR #12)", completion = 100 },
  { name = "gitleaks secret scanning added (PR #16) — this repo previously had none", completion = 100 },
  { name = "Fatal import bug fixed + registration test + package.json (branch fix/honest-gates-v2)", completion = 100 },
  { name = "just test able to fail honestly (remove the || echo fallback in Justfile)", completion = 100 },
  { name = "XSS remediation — all author/reader text rendered via textContent, no innerHTML (branch feat/render-core-variants-vars, 2026-10-05; tested under happy-dom; not yet merged)", completion = 100 },
  { name = "Fix focus-destroying re-render on every keystroke in variable inputs (same branch; shadow tree built once, patched in place)", completion = 100 },
  { name = "Preview toggle — dropped from README and from scope on 2026-10-05; not implemented", completion = 0 },
  { name = "Real A2ML parser wired up (currently a stub; tree-sitter WASM asset is a 118-byte placeholder)", completion = 0 },
  { name = "Live linter — removed as out of charter on 2026-10-05 (placeholder panel and view-manager.js deleted); not planned", completion = 0 },
  { name = "Split view — removed as out of charter on 2026-10-05; not planned", completion = 0 },
  { name = "Templating wizards — dropped from README and from scope; no code exists anywhere in the tree", completion = 0 },
  { name = "Accessibility verified with an automated audit and a real screen reader (implemented and unit-tested; not verified)", completion = 0 },
]

[blockers-and-issues]
# Full register with evidence: FACTS.md (.superpowers/sdd/progblocks-foamy-puzzle/FACTS.md).
blockers = [
  { id = "B1", kind = "code", state = "fixed", detail = "src/prog-block.js used to import { validateK9 } from k9-validator.js, which exports only K9Validator and defaultValidator — a link-time SyntaxError that stopped customElements.define('prog-block', ...) from ever running, leaving every <prog-block> on the demo page inert. Fixed by importing { defaultValidator } instead; since 2026-10-05 prog-block.js imports nothing at all. Guarded by tests/registration.test.js." },
  { id = "B2", kind = "code", state = "fixed", detail = "XSS — variant content used to be read via innerHTML and re-injected as HTML, and variable values interpolated unescaped into value=\"${val}\". Fixed 2026-10-05 on branch feat/render-core-variants-vars: the shadow tree is built with DOM APIs and every text value goes in via textContent; no innerHTML remains in src/. Guarded by tests/component.test.js (happy-dom, not a real browser)." },
  { id = "B3", kind = "code", state = "fixed", detail = "Editing a variable input used to trigger a full shadowRoot.innerHTML rewrite, destroying the focused <input>. Fixed 2026-10-05: inputs are created once and only the matching code spans are patched. Guarded by tests/component.test.js." },
  { id = "B4", kind = "code", state = "fixed", detail = "The contenteditable editor overwrote variant source with post-interpolation text. Resolved 2026-10-05 by removing the editor as out of charter." },
  { id = "B5", kind = "code", state = "fixed", detail = "Split view was wired wrong (:host([split-view]) never set). Resolved 2026-10-05 by removing split view as out of charter." },
  { id = "B6", kind = "code", state = "fixed", detail = "The live linter was a hardcoded placeholder string and view-manager.js was dead code. Resolved 2026-10-05 by deleting both; a linter is out of charter." },
  { id = "B7", kind = "test", state = "fixed", detail = "Justfile's test recipe used to be `node --test tests/ || echo \"No tests configured yet\"` — a real failure was swallowed and the recipe always exited 0. The `|| echo` fallback has been removed; the recipe is now `bun test` and propagates failure." },
  { id = "B8", kind = "cicd", state = "fixed", detail = "package.json and bun.lock exist in this tree, so CI's `bun install --frozen-lockfile` / `bun run test` have something to install and run" },
  { id = "B9", kind = "docs", state = "fixed", detail = "README.md used to advertise a code/preview toggle, templating wizards, and split/glyph editor modes that did not exist. Its feature table was rewritten on 2026-10-05 to match the code; re-check it against FACTS.md before repeating any claim." },
  { id = "B10", kind = "code", state = "open", detail = "Light-DOM changes after first connect are not observed: templates are read once and the shadow tree is built once. See DEBT.adoc C14." },
  { id = "B11", kind = "test", state = "open", detail = "Accessibility (WAI-ARIA tabs, labelled inputs, live region, focus rings, forced-colors) is implemented and its structure unit-tested under happy-dom, but has not been checked with a screen reader, an automated audit, or a contrast measurement. See DEBT.adoc T3." },
]

[critical-next-actions]
actions = [
  "Land branch feat/render-core-variants-vars (XSS and focus fixes, scope cut to the charter) and confirm whether SonarCloud's security rating recovers on it (DEBT.adoc G2).",
  "Verify accessibility with an automated audit and at least one real screen reader before making any AA claim (B11).",
  "Decide whether to observe light-DOM changes after first connect (B10).",
  "Resolve the version-string drift (1.0.0 / 0.1.0 / 0.3.0 across three files) before any tag is cut.",
]

[maintenance-status]
last-run-utc = "unknown"   # this pass did not query live GitHub Actions state;
                            # see descriptiles/PLAYBOOK.a2ml's diagnostic note —
                            # use `gh run list --repo metadatastician/progblocks`,
                            # not `gh pr checks`, to check
last-result = "unknown"     # unknown | pass | warn | fail
open-warnings = 2           # count of [blockers-and-issues] entries still open
                             # (B10/B11); B1–B9 are now state=fixed
open-failures = 0           # no failure has been mechanically confirmed by this pass;
                             # B10/B11 are known limitations, not CI failures

[ecosystem]
part-of = ["metadatastician"]
depends-on = []
sibling-projects = []   # no verified sibling relationship established in this pass;
                         # see descriptiles/ECOSYSTEM.a2ml for candidate/intended
                         # consumers (berrywiki, ddraig-ssg, nextgen-languages),
                         # none of which is a confirmed live integration
