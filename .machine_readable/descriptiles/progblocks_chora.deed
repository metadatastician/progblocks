;; SPDX-License-Identifier: MPL-2.0
;
; The repo deed of progblocks: the single machine-readable record of the repo
; (one-deed-per-repo doctrine, standards#837). It replaces every .a2ml file that
; used to sit in this repository (A2ML retired estate-wide; owner decision
; 2026-10-05). Grammar: standards 1-formats/deed/spec/abnf/deed.abnf; field
; mappings: standards 1-formats/deed/mappings/.
;
; Where the old files went:
;   CLADE, META, ECOSYSTEM, AGENTIC, NEUROSYM, PLAYBOOK -> clauses below (mapped)
;   0-AI-MANIFEST                -> (manifest ...) below (ai-manifest-decision Option A, owner 2026-10-05)
;   STATE v1                     -> (maturity ...) below; the journal is archived at
;                                   .machine_readable/archive/state-v1.txt (state-v1-decision Option B, owner 2026-10-05)
;   ANCHOR, rsr-profile          -> (anchor ...) and (rsr-profile ...) below (no ruled mapping yet)
;   .github/*/0.2-AI-MANIFEST    -> (ply ...) below
;   progblocks.launcher          -> progblocks.launcher_praxis.deed (launch-scaffolder #42 form)
;   contractiles/*/<Verb>file    -> contractiles/<verb>/<verb>.ncl (Nickel data; run by tools/run-probes.sh)
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "progblocks"
  :beholding-chora #u5"estate/chora"
  ; Grammar-required identity: UUIDv5 under the URL namespace, re-derivable with
  ; uuidgen --sha1 --namespace @url --name "github.com/metadatastician/progblocks"
  ; -> 74352a71-31d7-5bb3-a792-72ca575231b2 (gv-clade-index identity model).
  :repo-uuid #u5"github.com/metadatastician/progblocks"
  (identity
    :primary-forge github
    :owner "metadatastician"
    :prefixed-name "dx-progblocks"
    ; UUID v8, profile C (content-derived), per ADR-008 (standards#1158), adopted
    ; here AHEAD of ratification by owner decision 2026-10-05. ESTATE-UUID-V7 is
    ; still the binding standard and the deed grammar only carries #u5, so the
    ; v5 :repo-uuid above remains the grammar identity; this is its v8 twin.
    ; Derivation: bytes 0..15 of SHA-256("estate-repo-identity:github.com/metadatastician/progblocks"),
    ; then byte6 = (byte6 & 0x0f) | 0x80, byte8 = (byte8 & 0x3f) | 0x80.
    :uuid-v8 "3a8b147b-7006-8d01-9edb-c29c4d6551bb"
    :uuid-v8-profile C
    :uuid-v8-domain "estate-repo-identity")
  ; Root AI manifest (was 0-AI-MANIFEST.a2ml). It had no agent allocation, so there
  ; are no (agent ...) or (work ...) clauses; its invariants become policy rules.
  (manifest
    :last-updated "2026-10-05"
    :project "progblocks"
    :purpose "Root AI-assistant manifest for ProgBlocks, a pre-alpha, dependency-free web component (<prog-block>) for variant-aware, personalisable code examples in technical documentation. Conceived for BerryWiki but built standalone from the start; it must never require BerryWiki."
    :read-order ("this deed (.machine_readable/descriptiles/progblocks_chora.deed)" "README.md" "ARCHITECTURE.md" "EXPLAINME.adoc (every claim mapped to the code and test that evidence it)" "DEBT.adoc (known defects and their status)")
    :authority "src/prog-block.js and src/prog-block.css, read directly, are authoritative about behaviour. EXPLAINME.adoc and AUDIT.adoc record the evidence. On any disagreement between a document and the code, the code wins and the document is corrected."
    (policy :rules ("Licence is MPL-2.0. The SPDX header must be the first line of every source, workflow and machine-readable file. Do not swap in AGPL or another licence." "Never hand-edit progblocks-launcher.sh. It is generated by launch-scaffolder from progblocks.launcher_praxis.deed; fix the generator or its input, then regenerate." "Never re-inline action SHAs that .github/workflows/actions.lock owns. The lockfile is the pin (gh actions-lock); uses: lines carry tag refs." "The component must register: customElements.get('prog-block') must be truthy after src/prog-block.js loads. tests/registration.test.js guards this; re-run bun test rather than assuming it." "Do not document features the code does not implement. There is no code/preview toggle, templating wizard, linter, split view, smart paste, structured (JSON/CSV/Nickel) export or syntax highlighting. Light-DOM changes are observed; edits to a template .content need refresh(). The only storage is the opt-in persist variant name per group." "Nothing has been released. Every version field says the pre-release 0.3.0; bump them together when a tag is cut." "Never render author or reader text as markup: no innerHTML, insertAdjacentHTML or template-string DOM construction for content. tests/component.test.js guards this."))
    )
  ; Identity, clade, forges, lineage, status: mapping clade-to-repo-deed.
  (clade
    :primary dx
    :primary-name "Developer Ecosystem"
    :secondary ()
    :assigned "2026-08-07"
    :rationale "Developer Ecosystem (dx): progblocks' entire value proposition is a drop-in developer tool, a dependency-free custom element that other sites and documentation generators embed for code examples. It is not an end-user application (ap), a language implementation (nl) or a static-site generator; it is tooling other developers build documentation surfaces on.")
  (forges
    :github "metadatastician/progblocks"
    :gitlab ""
    :bitbucket "")
  (lineage
    :type standalone
    :parent ""
    :born "2026-07-23"
    :previous-names ()
    :instantiated-from "")
  (status
    :phase active
    :since "2026-07-23"
    :present #t
    :aliases ()
    :merged-into ""
    :superseded-by ""
    :successors ()
    :ended ""
    (history
      (entry :phase active :since "2026-07-23" :note "Repo created. CI had no green run until the rehabilitation sequence starting at PR #12; the render core, variants, variables and accessibility audit landed in PRs #44 to #49 (2026-10-05).")))
  ; STATE v1, Option B: only the maturity row is state; the journal is archived.
  ; Not beta: nothing is screen-reader-tested and nothing has been released.
  (maturity
    :level experimental
    :since "2026-10-05")
  ; Meta and ecosystem: mapping meta-ecosystem-to-repo-deed.
  ; :package-manager bun is outside the mapping's seen set (guix cargo mix) although
  ; Bun is the estate JavaScript runtime; recorded in dev-notes/inbox/findings.md.
  ; Design rationale (no ADRs exist): ESM with no build step, Shadow DOM, no framework.
  ; ARCHITECTURE.md describes the build-once, textContent-only render model.
  (meta
    :version "0.1.0"
    :last-updated "2026-10-05"
    :type library
    :languages (javascript)
    :license MPL-2.0
    :author "Jonathan D.A. Jewell (hyperpolymath)"
    :build-tool none
    :container-runtime none
    :ci-platform github-actions
    :package-manager bun)
  ; The relationship symbol consumer is outside the mapping's closed set, which has
  ; no consumer edge; recorded in dev-notes/inbox/findings.md. Coupling runs one way:
  ; consumers may embed progblocks, progblocks never requires a consumer.
  (ecosystem
    :project "progblocks"
    :ecosystem "metadatastician"
    :position-type "web component / library"
    :purpose "Dependency-free web component for variant-aware, personalisable code examples in technical documentation: WAI-ARIA variant tabs with optional group sync and opt-in persistence, {{ variable }} substitution with inline defaults, copy and plain-text download of the personalised text, and clipboard-safe line numbers."
    :not ("a syntax highlighter" "a static site generator" "a Markdown parser" "a code editor, IDE, linter or language-server client: the contenteditable editor, the placeholder linter and view-manager.js were removed on 2026-10-05 as out of charter" "a data-conversion tool: smart paste and the JSON/CSV/Nickel export were removed on 2026-10-05; only a plain-text Download remains" "a released package: nothing has been published; every version field says the pre-release 0.3.0")
    :pipeline-position "leaf, embeddable"
    :chain "conceived for metadatastician/berrywiki, decoupled by design -> embeddable in any consumer"
    :pipeline-notes "Built standalone so it can be injected into ddraig-ssg output, nextgen-languages previewers or plain HTML/Markdown sites. It does not generate a site or parse Markdown; it is a widget a site embeds. No consumer import of src/prog-block.js has been verified."
    :coordination ""
    (related :name "berrywiki" :relationship consumer :notes "Originating consumer (intended); not verified as importing src/prog-block.js.")
    (related :name "ddraig-ssg" :relationship consumer :notes "Candidate consumer; not verified.")
    (related :name "nextgen-languages" :relationship consumer :notes "Candidate consumer named in README.md; not verified."))
  ; Agent permissions and integrity: mapping agentic-neurosym-playbook-to-repo-deed.
  (agentic
    :version "0.1.0"
    :last-updated "2026-10-05"
    (permissions :source #t :tests #t :docs #t :config #t :create-files #t)
    (integrity
      :fail-closed #t
      :require-evidence-per-step #t
      :allow-silent-skip #f
      :require-rerun-after-fix #t
      :release-claim-requires-hard-pass #t)
    (constraints :rules ("Never commit secrets or credentials." "Never hand-edit progblocks-launcher.sh; it is generated by launch-scaffolder. Its current output cannot start the demo server (empty REPO_DIR, a startup search that cannot match a non-executable string); fix that upstream and regenerate." "Never re-inline action SHAs that .github/workflows/actions.lock owns." "Never claim a feature the code does not implement (see the manifest policy rules)." "Never claim accessibility conformance. The tabs pattern, labelled inputs, live region and focus rings are implemented and unit-tested; the axe-core audit (just a11y, also in CI) reports 0 violations; nothing has been screen-reader-tested. AA is a target." "Never render author or reader text as markup: no innerHTML for content in src/." "Never describe variable substitution as backed by a parser: it is a regular expression in tokenize() supporting {{ name }} and {{ name = default }}." "Licence is MPL-2.0; do not swap in another licence." "The component must register: customElements.get('prog-block') must be truthy after src/prog-block.js loads (tests/registration.test.js).")))
  (neurosym
    :version "0.1.0"
    :last-updated "2026-10-05"
    ; No formal proof claims. contracts.ncl and k9-validator.js, which only looked like
    ; validation, and package.k9, which nothing consumed, were deleted on 2026-10-06.
    :formal-proof-claims #f
    (hypatia :scan-enabled #t :scan-depth standard :report-format "logtalk")
    (evidence :kind test :tool "bun test (happy-dom)" :location "tests/" :notes "Unit and behaviour tests; also tools/a11y-audit.mjs (axe-core in Chromium), run in CI.")
    (evidence :kind static-analysis :tool "CodeQL" :location ".github/workflows/codeql.yml" :notes "Matrix scan: actions and javascript-typescript.")
    (evidence :kind secret-scan :tool "gitleaks" :location ".github/workflows/secret-scanner.yml" :notes "Added in PR #16.")
    (rule :name no-unescaped-innerhtml :pattern "\\.innerHTML\\s*=" :severity critical :notes "Regression guard: src/ has had no innerHTML assignment since 2026-10-05. A match is a reintroduced XSS surface.")
    (rule :name dead-module-import-guard :pattern "from ['\"]\\./modules/view-manager\\.js['\"]" :severity info :notes "view-manager.js was deleted on 2026-10-05 (a linter is out of charter)."))
  (playbook
    :version "0.1.0"
    :last-updated "2026-10-05"
    (testing :command "just test" :direct-command "bun test" :notes "The recipe is a bare bun test, the same runner CI uses; a green run means the tests passed. Tests run under happy-dom. just a11y runs the axe-core audit in a real Chromium.")
    (demo :method static-file :steps ("python3 -m http.server 8080   # or any static file server, from the repo root" "open http://localhost:8080/index.html") :notes "index.html imports src/prog-block.js directly; there is no build step. The stylesheet resolves against the module URL, so the page may live at any depth. progblocks-launcher.sh cannot currently start this server; use the command above.")
    (ci-verification
      :lockfile ".github/workflows/actions.lock (gh actions-lock); uses: lines carry tag refs, the lockfile holds the SHAs"
      (workflow :file ".github/workflows/ci.yml" :steps "checkout -> setup-bun -> bun install --frozen-lockfile -> bun run test -> accessibility audit; plus the action-pins job")
      (workflow :file ".github/workflows/codeql.yml" :steps "matrix scan: actions, javascript-typescript")
      (workflow :file ".github/workflows/secret-scanner.yml" :steps "gitleaks"))
    (diagnostics :notes ("gh pr checks hides startup_failure runs; use gh run list --repo metadatastician/progblocks to see the true state." "CI had no green run from repo creation (2026-07-23) until the rehabilitation sequence beginning with PR #12."))
    (incident-response :steps ("Read this deed, then DEBT.adoc for known defects." "Run gh run list --repo metadatastician/progblocks, not gh pr checks." "If the component is at issue, run bun test first: tests/registration.test.js fails if src/prog-block.js no longer loads or registers."))
    (release-process :steps ("Nothing has been released yet; treat the repo as pre-alpha." "Every version field says 0.3.0; bump them together, in one commit, when a tag is cut.")))
  ; Was ANCHOR.a2ml. No ruled deed mapping exists for ANCHOR yet; carried as a clause.
  (anchor
    :schema "hyperpolymath.anchor/1"
    :repo "metadatastician/progblocks"
    :authority upstream-canonical
    :domain developer-tooling
    :policy facts-over-aspiration
    :purpose ("Define canonical semantics and policy boundaries for this repository." "Provide a stable golden path and invariant contract for release readiness." "Say plainly which source wins when documentation and the code disagree.")
    :owns ("What the component actually does: src/prog-block.js and src/prog-block.css, read directly, are authoritative, not any feature list" "What is and isn't verified about this repo (EXPLAINME.adoc, AUDIT.adoc)")
    (supersedes :lower "README.md feature list" :higher "src/ as read, with EXPLAINME.adoc as its evidence map" :note "Resolve drift by fixing the document, never by weakening the facts.")
    (supersedes :lower "progblocks-launcher.sh (generated)" :higher "progblocks.launcher_praxis.deed (its input)" :note "The generated script is what is broken, not its input.")
    (implementation-policy
      :allowed ("JavaScript (ESM, no bundler)" "CSS (Shadow DOM)" "HTML" "Shell" "Nickel" "DEED" "KYAML" "AsciiDoc" "Markdown")
      :forbidden ("re-inlining action SHAs that .github/workflows/actions.lock owns" "hand-editing progblocks-launcher.sh" "claiming a feature the code does not implement" "new .a2ml files (A2ML is retired)"))
    (golden-path
      :smoke-test ("bun test" "just a11y   # CHROMIUM_PATH set" "python3 -m http.server 8080   # then open index.html")
      :success-criteria ("customElements.get('prog-block') is defined after the module graph loads, with no console errors" "bun test exits non-zero on a real failure" "ci.yml's build job passes: tests and the accessibility audit"))
    (satellite-policy :must-pin-upstream #f :must-declare-authority #f :must-have-anchor #f :must-have-golden-path #f :notes "A standalone leaf; it tracks and pins no consumer."))
  ; Was .machine_readable/rsr-profile.a2ml (RSR v2.0 declared capabilities). No ruled
  ; deed mapping exists yet; the RSR oracle must read it from here (findings.md).
  ; Not declared, deliberately: ffi, abi, formal-proofs, container, cli, api-service,
  ; published-package, mobile, docs-site, benchmarks, governance-tier.
  (rsr-profile
    :version "1.0.0"
    :spec "rsr-criteria-v2"
    :declares-against "2.0.0-draft"
    :capabilities (web-ui library)
    :omitted-rationale "Declaring a capability this repo lacks would make the oracle score it against a module it does not carry. Under-declaring is honest; over-declaring manufactures both false gaps and false credit."
    (deviation :item "README.md rather than README.adoc" :reason "A tolerated deviation for small repos; there is no parallel README.adoc."))
  ; Directory manifests (were .github/ISSUE_TEMPLATE and DISCUSSION_TEMPLATE 0.2-AI-MANIFEST.a2ml).
  (ply
    (directory :ply 1 :path ".github")
    (directory :ply 2 :path ".github/ISSUE_TEMPLATE" :description "GitHub issue templates that standardise issue reporting and tracking for progblocks."
      :authority "Central protocol authority: the standards repository issue template standards. Local integration authority: this directory."
      :invariants ("All template files must be valid GitHub issue template YAML (KYAML)." "Templates must collect the information needed for triage." "Each template must have a clear name, description and labels.")
      (file :name "bug_report.yml" :description "Bugs and defects")
      (file :name "feature_request.yml" :description "New features")
      (file :name "documentation.yml" :description "Documentation requests")
      (file :name "question.yml" :description "General questions")
      (file :name "custom.yml" :description "Other issue types")
      (file :name "config.yml" :description "Template chooser configuration")
      )
    (directory :ply 2 :path ".github/DISCUSSION_TEMPLATE" :description "GitHub discussion templates that structure community conversations for progblocks."
      :authority "Central protocol authority: the standards repository discussion template standards. Local integration authority: this directory."
      :invariants ("All template files must be valid GitHub discussion template YAML (KYAML)." "Templates must give clear guidance on the discussion topic." "Each template must have a clear category and purpose.")
      (file :name "q-and-a.yml" :description "Q&A discussions")
      (file :name "ideas.yml" :description "Ideas")
      )
    ))
