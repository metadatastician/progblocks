#
# META.a2ml — Project meta-level information
# Architecture decisions, design rationale, governance.

[metadata]
version = "0.1.0"
last-updated = "2026-10-05"

[project-info]
type = "web component / library"
languages = ["javascript"]
license = "MPL-2.0"
author = "Jonathan D.A. Jewell (hyperpolymath)"

[architecture-decisions]
# No ADRs exist yet for this repository — there is no docs/adr/ directory
# and no DECISIONS.md. None of the design choices visible in the tree
# (ESM-only, no bundler, Shadow DOM, no framework) have been formally
# recorded anywhere except commit messages (PR #12, #15, #16, and the
# fatal-import-fix commit on branch fix/honest-gates-v2). This array is intentionally empty rather
# than backfilled with invented ADRs — under-declaring is honest.
decisions = []

[development-practices]
build-tool = "none"     # The Justfile used to have a `build` recipe that
                         # cat-concatenated ES modules into one file without
                         # stripping import/export syntax, producing a file
                         # that could not run as a script. Rather than fix
                         # it, the recipe was deleted.
ci-platform = "github-actions"
package-manager = "bun"  # package.json (private: true) + bun.lock; CI runs
                          # bun install --frozen-lockfile and bun run test

[design-rationale]
notes = "There are no ADRs. ARCHITECTURE.md describes the module map and render model (since 2026-10-05: shadow tree built once with DOM APIs, patched in place, rebuilt only when the authored light DOM changes, all text via textContent). Alongside it are README.md (feature list, rewritten to match the code on 2026-10-05) and .superpowers/sdd/progblocks-foamy-puzzle/FACTS.md (verified source-read inventory) — see descriptiles/ANCHOR.a2ml for which one is authoritative when they disagree. If an ADR process starts, the first entry worth writing is why prog-block.js ships as ESM with no build step, and why a2ml-parser.js's tree-sitter path is commented out rather than wired up."
